#

$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch.o :  ../HammingMatch.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.h $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(BDW_WORKLIB)/wrappers/HammingMatch_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
