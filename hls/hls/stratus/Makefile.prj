$(subst /PIPE1/,/PIPE1$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/debug/HammingMatch_hoist.o) :  ../HammingMatch.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(subst /PIPE1/,/PIPE1$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/HammingMatch_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /PIPE1/,/PIPE1$(BDW_SPEC_SUF)/,$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE1 -I./ $(CCFLAGS_HammingMatch_PIPE1) $(EXTRACT_LIB_DASHI_HammingMatch_PIPE1) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/debug/HammingMatch_hoist.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch.d :  ../HammingMatch.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config PIPE1 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_HammingMatch_PIPE1)  ../HammingMatch.cpp \
	| sed 's|HammingMatch\.o[ :]*|$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_rtl.cpp $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_beh.o $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/debug/HammingMatch_beh.o $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch.d :  |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



