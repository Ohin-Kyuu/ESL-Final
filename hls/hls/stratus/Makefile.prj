#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch.d :  ../HammingMatch.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config BASIC of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_HammingMatch_BASIC)  ../HammingMatch.cpp \
	| sed 's|HammingMatch\.o[ :]*|$(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch_rtl.cpp $(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch_beh.o $(BDW_WORKLIB)/modules/HammingMatch/BASIC/debug/HammingMatch_beh.o $(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch.d :  |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/HammingMatch/BASIC"
##############################################################

HammingMatch_BASIC_SRCDIR = $(BDW_WORKLIB)/modules/HammingMatch/BASIC
HammingMatch_BASIC_BEH_SRCDIR = $(BDW_WORKLIB)/libs/HammingMatch_BASIC
HammingMatch_BASIC_LIBNAME = HammingMatch_BASIC
HammingMatch_BASIC_WORKLIB = $(BDW_WORKLIB)/modules/HammingMatch/BASIC
HammingMatch_BASIC_C_PARTS_A = $(HammingMatch_BASIC_WORKLIB)/objs/libHammingMatch_BASIC.a

prep_c_HammingMatch_BASIC : $(HammingMatch_BASIC_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_BASIC_WORKLIB) prep_c

prep_c_HammingMatch_BASIC_% : $(HammingMatch_BASIC_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_BASIC_WORKLIB)_$(*F) prep_c

prep_vlog_HammingMatch_BASIC : $(HammingMatch_BASIC_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_BASIC_WORKLIB) prep_vlog

prep_vlog_HammingMatch_BASIC_% : $(HammingMatch_BASIC_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_BASIC_WORKLIB)_$(*F) prep_vlog

prep_HammingMatch_BASIC : $(HammingMatch_BASIC_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_BASIC_WORKLIB) prep

prep_HammingMatch_BASIC_% : $(HammingMatch_BASIC_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_BASIC_WORKLIB)_$(*F) prep

$(HammingMatch_BASIC_WORKLIB)/Makefile : $(HammingMatch_BASIC_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(HammingMatch_BASIC_WORKLIB) ]; then mkdir -p $(HammingMatch_BASIC_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim builtin -lib $(HammingMatch_BASIC_SRCDIR) -o $(HammingMatch_BASIC_WORKLIB)/Makefile -module HammingMatch -cynthconfig BASIC   

$(HammingMatch_BASIC_WORKLIB)_%/Makefile : $(HammingMatch_BASIC_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(HammingMatch_BASIC_WORKLIB)_$(*F) ]; then mkdir -p $(HammingMatch_BASIC_WORKLIB)_$(*F); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim builtin -lib $(HammingMatch_BASIC_SRCDIR)_$(*F) -o $(HammingMatch_BASIC_WORKLIB)_$(*F)/Makefile -module HammingMatch -cynthconfig BASIC_$(*F)   

$(HammingMatch_BASIC_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(HammingMatch_BASIC_WORKLIB) ]; then mkdir -p $(HammingMatch_BASIC_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi

$(HammingMatch_BASIC_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(HammingMatch_BASIC_WORKLIB)_$(*F) ]; then mkdir -p $(HammingMatch_BASIC_WORKLIB)_$(*F); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(HammingMatch_BASIC_WORKLIB)/HammingMatch_BASIC.d :
	@if [ ! -d $(HammingMatch_BASIC_WORKLIB) ]; then mkdir -p $(HammingMatch_BASIC_WORKLIB); fi
	@touch $(HammingMatch_BASIC_WORKLIB)/HammingMatch_BASIC.d



#
# HLS config DPO
#

#
#	stratus_hls rule
#
LIB_DIRS_HammingMatch_DPO = 
LIB_INCLUDES_HammingMatch_DPO = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_DPO))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_HammingMatch_DPO = 
LIB_NAMES_FOR_VLOG_HammingMatch_DPO = 
PREFIXED_LIB_NAMES_HammingMatch_DPO = 
EXTRACT_LIB_DASHI_HammingMatch_DPO = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl HammingMatch DPO]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_HammingMatch_DPO = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/DPO/c_parts -DDPO=1 -DBDW_RTL_HammingMatch_DPO=1  -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_DPO)
CCFLAGS_COSIM_HammingMatch_DPO = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/DPO/c_parts -DDPO=1 -DBDW_RTL_HammingMatch_DPO=1  -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_DPO)
CCFLAGS_BEH_HammingMatch_DPO = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/DPO/c_parts -DDPO=1  -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_DPO)
CCFLAGS_HammingMatch_DPO += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_HammingMatch_DPO += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_HammingMatch_DPO += ${BDW_CCFLAGS_TAIL}

hls_HammingMatch_DPO : hlsc_HammingMatch_DPO

cynth_HammingMatch_DPO : hlsc_HammingMatch_DPO

elab_HammingMatch_DPO : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/DPO/stratus_hls.bdr

optim_HammingMatch_DPO : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/DPO/stratus_hls.bdr

sched_HammingMatch_DPO : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/DPO/stratus_hls.bdr

.PHONY: hlsc_HammingMatch_DPO hls_HammingMatch_DPO

hlsc_HammingMatch_DPO : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.cpp BDW_DEP_CYNTH_CONFIG=DPO BDW_MODULE=HammingMatch BDW_HLS_CONFIG=DPO
else
	@bdw_exec -jobproject project.tcl -job hls.HammingMatch.DPO $(MAKE) CWBExec_hls=1 hlsc_HammingMatch_DPO
endif

clean_cynth_HammingMatch_DPO: clean_hls_HammingMatch_DPO

clean_HammingMatch_DPO: clean_hls_HammingMatch_DPO

clean_hls_HammingMatch_DPO:
	@rm -rf $(BDW_WORKLIB)/modules/HammingMatch/DPO
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.DPO
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.DPO.s

kill_hls_HammingMatch_DPO:
	@bdw_kill -job hls.HammingMatch.DPO
	@bdw_kill -job hls.HammingMatch.DPO.s


hls_HammingMatch_DPO_% : hlsc_HammingMatch_DPO_%

cynth_HammingMatch_DPO_% : hlsc_HammingMatch_DPO_%

elab_HammingMatch_DPO_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(subst /DPO/,/DPO_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/stratus_hls.bdr)

optim_HammingMatch_DPO_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(subst /DPO/,/DPO_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/stratus_hls.bdr)

sched_HammingMatch_DPO_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(subst /DPO/,/DPO_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/stratus_hls.bdr)

.PHONY: hlsc_HammingMatch_DPO_% hls_HammingMatch_DPO_%

hlsc_HammingMatch_DPO_% hls_HammingMatch_DPO_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /DPO/,/DPO_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.cpp) BDW_DEP_CYNTH_CONFIG=DPO BDW_MODULE=HammingMatch BDW_HLS_CONFIG=DPO_$(*F)
else
	@bdw_exec -jobproject project.tcl -job hls.HammingMatch.DPO_$(*F) $(MAKE) CWBExec_hls=1 hlsc_HammingMatch_DPO_$(*F)
endif

clean_cynth_HammingMatch_DPO_%: clean_hls_HammingMatch_DPO_%

clean_HammingMatch_DPO_%: clean_hls_HammingMatch_DPO_%

clean_hls_HammingMatch_DPO_%:
	@rm -rf $(BDW_WORKLIB)/modules/HammingMatch/DPO_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.DPO_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.DPO_$(*F).s

kill_hls_HammingMatch_DPO_%:
	@bdw_kill -job hls.HammingMatch.DPO_$(*F)
	@bdw_kill -job hls.HammingMatch.DPO_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),DPO)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch.d
                BDW_LIB_DEPS = 
            endif
        endif
    endif
endif


html_HammingMatch_DPO :
	bdw_htmlgen -project project.tcl -module HammingMatch -cynthconfig DPO

BDW_HammingMatch_DPO_HLS_TARGETS = $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.cpp $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.v $(BDW_WORKLIB)/modules/HammingMatch/DPO/stratus_hls.bdr
BDW_HammingMatch_DPO_HLS_SPEC_TARGETS = $(subst /DPO/,/DPO_%/,$(BDW_HammingMatch_DPO_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_HammingMatch_DPO_HLS_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/HammingMatch/DPO ]; then mkdir -p $(BDW_WORKLIB)/modules/HammingMatch/DPO; fi
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=DPO BDW_CYNTH_CONFIG=DPO \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.cpp \
		BDW_MODULE=HammingMatch \
		BDW_CYNTH_CONFIG=DPO \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/DPO \
		BDW_HLS_CONFIG=DPO \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/DPO \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_HammingMatch_DPO) \
		-d $(BDW_WORKLIB)/modules/HammingMatch/DPO -o HammingMatch_rtl.cpp \
		--hls_module=HammingMatch --hls_config=DPO --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_DPO))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_HammingMatch_DPO))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_HammingMatch_DPO))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_HammingMatch_DPO) \
		 ../HammingMatch.cpp
	
	
	
	

else

$(BDW_HammingMatch_DPO_HLS_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.HammingMatch.DPO.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_HammingMatch_DPO_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_trace.h : $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_trace.h.updated

$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_trace.h.updated : $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module HammingMatch -cynthconfig DPO  
	@touch $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_HammingMatch_DPO_HLS_SPEC_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/HammingMatch/DPO_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/HammingMatch/DPO_$(*F); fi
	
	$(subst /DPO ,/DPO_$(*F) ,$(subst =DPO ,=DPO_$(*F) ,$(subst /HammingMatch/DPO/,/HammingMatch/DPO_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=DPO BDW_CYNTH_CONFIG=DPO \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.cpp \
		BDW_MODULE=HammingMatch \
		BDW_CYNTH_CONFIG=DPO \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/DPO \
		BDW_HLS_CONFIG=DPO \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/DPO \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_HammingMatch_DPO) \
		`cat  $(BDW_SPECLIB)/HammingMatch/DPO.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/HammingMatch/DPO -o HammingMatch_rtl.cpp \
		--hls_module=HammingMatch --hls_config=DPO --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_DPO))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_HammingMatch_DPO))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_HammingMatch_DPO))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_HammingMatch_DPO) \
		 ../HammingMatch.cpp)))
	
	
	
	

else

$(BDW_HammingMatch_DPO_HLS_SPEC_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.HammingMatch.DPO_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_HammingMatch_DPO_HLS_SPEC_TARGETS))

endif

	

$(subst /DPO/,/DPO_%/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_trace.h) : $(subst /DPO/,/DPO_%/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module HammingMatch -cynthconfig DPO_$(*F)  

catHLLog_HammingMatch_DPO:
	cat $(BDW_WORKLIB)/modules/HammingMatch/DPO/stratus_hls.log

