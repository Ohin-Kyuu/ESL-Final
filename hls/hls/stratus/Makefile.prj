	@$(MAKE)  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl HammingMatch`
	$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/ -I./ $(CCFLAGS_HammingMatch_UNROLL) $(EXTRACT_LIB_DASHI_HammingMatch_UNROLL) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_rtl.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp

