#############################################################################
# libesc building rules
#############################################################################

ifeq ($(BDW_DEBUG),1)
libesc_WORKDIR = $(BDW_WORKLIB)/libesc/debug
else
libesc_WORKDIR = $(BDW_WORKLIB)/libesc
endif

BDW_ESC_SOURCES = libesc.o esc_elab.o esc_cleanup.o
BDW_ESC_OBJS = $(addprefix $(libesc_WORKDIR)/, $(BDW_ESC_SOURCES))

$(libesc_WORKDIR)/libesc.a : $(BDW_ESC_OBJS)
	$(BDW_AR) $(libesc_WORKDIR)/libesc.a $(BDW_ESC_OBJS)

${libesc_WORKDIR}/%.o   :   ${STRATUS_HOME}/share/stratus/source/%.cc 
	@if [ ! -d ${libesc_WORKDIR} ]; then mkdir -p ${libesc_WORKDIR}; fi
ifeq ($(BDW_NCSC),1)
	${BDW_CC} " ${BDW_CCFLAGS} ${BDW_COUT}$@ " $<
else
	${BDW_CC} ${BDW_CCFLAGS} ${BDW_COUT}$@ $<
endif



########################################################################
# Rules to prep all libraries
#######################################################################
prep_c_all: $(BDW_C_LIBPREP)

prep_vlog_all: $(BDW_VLOG_LIBPREP)


##############################################################
## Rule for building all Cynth libraries external to the project
##############################################################

build_all_cynthLibs: $(BDW_BOTH_LIBPREP_EXTERNAL)

list_cynthLibs:


##############################################################
## START OF HLS MODULE RULES
##############################################################



##############################################################
## HLS Module "HammingMatch"
##############################################################


#
# Dependency Generation rule for BEH module
#
$(BDW_OBJDIR)/HammingMatch.d :  ../HammingMatch.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for $< "
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS)  ../HammingMatch.cpp \
	| sed 's|HammingMatch\.o[ :]*|$(BDW_OBJDIR)/HammingMatch.o $(BDW_OBJDIR)/HammingMatch.d : |' $(BDW_DEP_FILTER)  > $@

$(BDW_WORKLIB)/wrappers/HammingMatch_trace.h : $(BDW_WORKLIB)/wrappers/HammingMatch_trace.h.updated

$(BDW_WORKLIB)/wrappers/HammingMatch_trace.h.updated :  ../HammingMatch.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module HammingMatch  
	@touch $(BDW_WORKLIB)/wrappers/HammingMatch_trace.h.updated



$(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/HammingMatch.o:  ../HammingMatch.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.h $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(BDW_WORKLIB)/wrappers/HammingMatch_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC)  $(BDW_CCFLAGS)   -o $(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/HammingMatch.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp

$(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/debug/HammingMatch.o:  ../HammingMatch.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.h $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(BDW_WORKLIB)/wrappers/HammingMatch_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC)  $(BDW_CCFLAGS)   -o $(BDW_WORKLIB)/sims/$(BDW_SIM_CONFIG)/debug/HammingMatch.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp

.INTERMEDIATE : HammingMatch_wrap.h

HammingMatch_wrap.h : $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.h

$(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.h $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.v   : $(BDW_WRAPDIR)/HammingMatch.updated

$(BDW_WRAPDIR)/HammingMatch.updated :  ../HammingMatch.cpp 
	@if [ ! -d $(BDW_WRAPDIR) ]; then mkdir -p $(BDW_WRAPDIR); fi
	$(BDW_WRAPGEN_COMMAND) -project project.tcl -module HammingMatch "-I$(BDW_WRAPDIR) $(BDW_LIB_DASHI) $(BDW_CCOPTIONS) $(BDW_EXTRA_CCFLAGS)"
	@touch $(BDW_WRAPDIR)/HammingMatch.updated
	$(STRATUS_HOME)/bin/bdw_tracegen -module HammingMatch  
	@touch $(BDW_WORKLIB)/wrappers/HammingMatch_trace.h.updated
$(BDW_WORKLIB)/wrappers/HammingMatch_wrap.d :  ../HammingMatch.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@set -e; $(BDW_CCDEP) -MM -MG $(BDW_CCFLAGS)   ../HammingMatch.cpp \
		| sed 's|HammingMatch\.o[ :]*|$(BDW_WRAPDIR)/HammingMatch.updated $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.d :  |' $(BDW_DEP_FILTER) > $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.d 




##############################################################
## HLS Module "HammingMatch" - cynthConfigs
##############################################################


#
# HLS config BASIC
#

#
#	stratus_hls rule
#
LIB_DIRS_HammingMatch_BASIC = 
LIB_INCLUDES_HammingMatch_BASIC = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_BASIC))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_HammingMatch_BASIC = 
LIB_NAMES_FOR_VLOG_HammingMatch_BASIC = 
PREFIXED_LIB_NAMES_HammingMatch_BASIC = 
EXTRACT_LIB_DASHI_HammingMatch_BASIC = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl HammingMatch BASIC]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_HammingMatch_BASIC = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/BASIC/c_parts -DBASIC=1 -DBDW_RTL_HammingMatch_BASIC=1   $(LIB_INCLUDES_HammingMatch_BASIC)
CCFLAGS_COSIM_HammingMatch_BASIC = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/BASIC/c_parts -DBASIC=1 -DBDW_RTL_HammingMatch_BASIC=1   $(LIB_INCLUDES_HammingMatch_BASIC)
CCFLAGS_BEH_HammingMatch_BASIC = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/BASIC/c_parts -DBASIC=1   $(LIB_INCLUDES_HammingMatch_BASIC)
CCFLAGS_HammingMatch_BASIC += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_HammingMatch_BASIC += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_HammingMatch_BASIC += ${BDW_CCFLAGS_TAIL}

hls_HammingMatch_BASIC : hlsc_HammingMatch_BASIC

cynth_HammingMatch_BASIC : hlsc_HammingMatch_BASIC

elab_HammingMatch_BASIC : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/BASIC/stratus_hls.bdr

optim_HammingMatch_BASIC : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/BASIC/stratus_hls.bdr

sched_HammingMatch_BASIC : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/BASIC/stratus_hls.bdr

.PHONY: hlsc_HammingMatch_BASIC hls_HammingMatch_BASIC

hlsc_HammingMatch_BASIC : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch_rtl.cpp BDW_DEP_CYNTH_CONFIG=BASIC BDW_MODULE=HammingMatch BDW_HLS_CONFIG=BASIC
else
	@bdw_exec -jobproject project.tcl -job hls.HammingMatch.BASIC $(MAKE) CWBExec_hls=1 hlsc_HammingMatch_BASIC
endif

clean_cynth_HammingMatch_BASIC: clean_hls_HammingMatch_BASIC

clean_HammingMatch_BASIC: clean_hls_HammingMatch_BASIC

clean_hls_HammingMatch_BASIC:
	@rm -rf $(BDW_WORKLIB)/modules/HammingMatch/BASIC
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.BASIC
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.BASIC.s

kill_hls_HammingMatch_BASIC:
	@bdw_kill -job hls.HammingMatch.BASIC
	@bdw_kill -job hls.HammingMatch.BASIC.s


hls_HammingMatch_BASIC_% : hlsc_HammingMatch_BASIC_%

cynth_HammingMatch_BASIC_% : hlsc_HammingMatch_BASIC_%

elab_HammingMatch_BASIC_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/BASIC/stratus_hls.bdr)

optim_HammingMatch_BASIC_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/BASIC/stratus_hls.bdr)

sched_HammingMatch_BASIC_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/BASIC/stratus_hls.bdr)

.PHONY: hlsc_HammingMatch_BASIC_% hls_HammingMatch_BASIC_%

hlsc_HammingMatch_BASIC_% hls_HammingMatch_BASIC_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /BASIC/,/BASIC_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch_rtl.cpp) BDW_DEP_CYNTH_CONFIG=BASIC BDW_MODULE=HammingMatch BDW_HLS_CONFIG=BASIC_$(*F)
else
	@bdw_exec -jobproject project.tcl -job hls.HammingMatch.BASIC_$(*F) $(MAKE) CWBExec_hls=1 hlsc_HammingMatch_BASIC_$(*F)
endif

clean_cynth_HammingMatch_BASIC_%: clean_hls_HammingMatch_BASIC_%

clean_HammingMatch_BASIC_%: clean_hls_HammingMatch_BASIC_%

clean_hls_HammingMatch_BASIC_%:
	@rm -rf $(BDW_WORKLIB)/modules/HammingMatch/BASIC_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.BASIC_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.BASIC_$(*F).s

kill_hls_HammingMatch_BASIC_%:
	@bdw_kill -job hls.HammingMatch.BASIC_$(*F)
	@bdw_kill -job hls.HammingMatch.BASIC_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),BASIC)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch.d
                BDW_LIB_DEPS = 
            endif
        endif
    endif
endif


html_HammingMatch_BASIC :
	bdw_htmlgen -project project.tcl -module HammingMatch -cynthconfig BASIC

BDW_HammingMatch_BASIC_HLS_TARGETS = $(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch_rtl.cpp $(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch_rtl.v $(BDW_WORKLIB)/modules/HammingMatch/BASIC/stratus_hls.bdr
BDW_HammingMatch_BASIC_HLS_SPEC_TARGETS = $(subst /BASIC/,/BASIC_%/,$(BDW_HammingMatch_BASIC_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_HammingMatch_BASIC_HLS_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/HammingMatch/BASIC ]; then mkdir -p $(BDW_WORKLIB)/modules/HammingMatch/BASIC; fi
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC BDW_CYNTH_CONFIG=BASIC \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch_rtl.cpp \
		BDW_MODULE=HammingMatch \
		BDW_CYNTH_CONFIG=BASIC \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/BASIC \
		BDW_HLS_CONFIG=BASIC \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/BASIC \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_HammingMatch_BASIC) \
		-d $(BDW_WORKLIB)/modules/HammingMatch/BASIC -o HammingMatch_rtl.cpp \
		--hls_module=HammingMatch --hls_config=BASIC --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_BASIC))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_HammingMatch_BASIC))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_HammingMatch_BASIC))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_HammingMatch_BASIC) \
		 ../HammingMatch.cpp
	
	
	
	

else

$(BDW_HammingMatch_BASIC_HLS_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.HammingMatch.BASIC.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_HammingMatch_BASIC_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch_trace.h : $(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch_trace.h.updated

$(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch_trace.h.updated : $(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module HammingMatch -cynthconfig BASIC  
	@touch $(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_HammingMatch_BASIC_HLS_SPEC_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/HammingMatch/BASIC_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/HammingMatch/BASIC_$(*F); fi
	
	$(subst /BASIC ,/BASIC_$(*F) ,$(subst =BASIC ,=BASIC_$(*F) ,$(subst /HammingMatch/BASIC/,/HammingMatch/BASIC_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=BASIC BDW_CYNTH_CONFIG=BASIC \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch_rtl.cpp \
		BDW_MODULE=HammingMatch \
		BDW_CYNTH_CONFIG=BASIC \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/BASIC \
		BDW_HLS_CONFIG=BASIC \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/BASIC \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_HammingMatch_BASIC) \
		`cat  $(BDW_SPECLIB)/HammingMatch/BASIC.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/HammingMatch/BASIC -o HammingMatch_rtl.cpp \
		--hls_module=HammingMatch --hls_config=BASIC --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_BASIC))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_HammingMatch_BASIC))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_HammingMatch_BASIC))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_HammingMatch_BASIC) \
		 ../HammingMatch.cpp)))
	
	
	
	

else

$(BDW_HammingMatch_BASIC_HLS_SPEC_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.HammingMatch.BASIC_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_HammingMatch_BASIC_HLS_SPEC_TARGETS))

endif

	

$(subst /BASIC/,/BASIC_%/,$(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch_trace.h) : $(subst /BASIC/,/BASIC_%/,$(BDW_WORKLIB)/modules/HammingMatch/BASIC/HammingMatch_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module HammingMatch -cynthconfig BASIC_$(*F)  

