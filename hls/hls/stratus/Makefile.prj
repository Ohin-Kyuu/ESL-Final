clean_HammingMatch_PIPE4_%: clean_hls_HammingMatch_PIPE4_%

clean_hls_HammingMatch_PIPE4_%:
	@rm -rf $(BDW_WORKLIB)/modules/HammingMatch/PIPE4_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.PIPE4_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.PIPE4_$(*F).s

kill_hls_HammingMatch_PIPE4_%:
	@bdw_kill -job hls.HammingMatch.PIPE4_$(*F)
	@bdw_kill -job hls.HammingMatch.PIPE4_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),PIPE4)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/HammingMatch/PIPE4/HammingMatch.d
                BDW_LIB_DEPS = 
            endif
        endif
    endif
endif


html_HammingMatch_PIPE4 :
	bdw_htmlgen -project project.tcl -module HammingMatch -cynthconfig PIPE4

BDW_HammingMatch_PIPE4_HLS_TARGETS = $(BDW_WORKLIB)/modules/HammingMatch/PIPE4/HammingMatch_rtl.cpp $(BDW_WORKLIB)/modules/HammingMatch/PIPE4/HammingMatch_rtl.v $(BDW_WORKLIB)/modules/HammingMatch/PIPE4/stratus_hls.bdr
BDW_HammingMatch_PIPE4_HLS_SPEC_TARGETS = $(subst /PIPE4/,/PIPE4_%/,$(BDW_HammingMatch_PIPE4_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_HammingMatch_PIPE4_HLS_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/HammingMatch/PIPE4 ]; then mkdir -p $(BDW_WORKLIB)/modules/HammingMatch/PIPE4; fi
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE4 BDW_CYNTH_CONFIG=PIPE4 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/PIPE4/HammingMatch_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/PIPE4/HammingMatch_rtl.cpp \
		BDW_MODULE=HammingMatch \
		BDW_CYNTH_CONFIG=PIPE4 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/PIPE4 \
		BDW_HLS_CONFIG=PIPE4 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/PIPE4 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_HammingMatch_PIPE4) \
		-d $(BDW_WORKLIB)/modules/HammingMatch/PIPE4 -o HammingMatch_rtl.cpp \
		--hls_module=HammingMatch --hls_config=PIPE4 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_PIPE4))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_HammingMatch_PIPE4))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_HammingMatch_PIPE4))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_HammingMatch_PIPE4) \
		 ../HammingMatch.cpp
	
	
	
	

else

$(BDW_HammingMatch_PIPE4_HLS_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.HammingMatch.PIPE4.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_HammingMatch_PIPE4_HLS_TARGETS)

