#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch.d :  ../HammingMatch.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config PIPE2 of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_HammingMatch_PIPE2)  ../HammingMatch.cpp \
	| sed 's|HammingMatch\.o[ :]*|$(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch_rtl.cpp $(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch_beh.o $(BDW_WORKLIB)/modules/HammingMatch/PIPE2/debug/HammingMatch_beh.o $(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch.d :  |' $(BDW_DEP_FILTER)  > $@

