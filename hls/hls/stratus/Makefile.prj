	bdw_htmlgen -project project.tcl -module HammingMatch -cynthconfig PIPE_UNROLL

BDW_HammingMatch_PIPE_UNROLL_HLS_TARGETS = $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_rtl.cpp $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_rtl.v $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/stratus_hls.bdr
BDW_HammingMatch_PIPE_UNROLL_HLS_SPEC_TARGETS = $(subst /PIPE_UNROLL/,/PIPE_UNROLL_%/,$(BDW_HammingMatch_PIPE_UNROLL_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_HammingMatch_PIPE_UNROLL_HLS_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL ]; then mkdir -p $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL; fi
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE_UNROLL BDW_CYNTH_CONFIG=PIPE_UNROLL \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_rtl.cpp \
		BDW_MODULE=HammingMatch \
		BDW_CYNTH_CONFIG=PIPE_UNROLL \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL \
		BDW_HLS_CONFIG=PIPE_UNROLL \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_HammingMatch_PIPE_UNROLL) \
		-d $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL -o HammingMatch_rtl.cpp \
		--hls_module=HammingMatch --hls_config=PIPE_UNROLL --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_PIPE_UNROLL))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_HammingMatch_PIPE_UNROLL))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_HammingMatch_PIPE_UNROLL))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_HammingMatch_PIPE_UNROLL) \
		 ../HammingMatch.cpp
	
	
	
	

else

$(BDW_HammingMatch_PIPE_UNROLL_HLS_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.HammingMatch.PIPE_UNROLL.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_HammingMatch_PIPE_UNROLL_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_trace.h : $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_trace.h.updated

$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_trace.h.updated : $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module HammingMatch -cynthconfig PIPE_UNROLL  
	@touch $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_HammingMatch_PIPE_UNROLL_HLS_SPEC_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL_$(*F); fi
	
	$(subst /PIPE_UNROLL ,/PIPE_UNROLL_$(*F) ,$(subst =PIPE_UNROLL ,=PIPE_UNROLL_$(*F) ,$(subst /HammingMatch/PIPE_UNROLL/,/HammingMatch/PIPE_UNROLL_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE_UNROLL BDW_CYNTH_CONFIG=PIPE_UNROLL \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_rtl.cpp \
		BDW_MODULE=HammingMatch \
		BDW_CYNTH_CONFIG=PIPE_UNROLL \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL \
		BDW_HLS_CONFIG=PIPE_UNROLL \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_HammingMatch_PIPE_UNROLL) \
		`cat  $(BDW_SPECLIB)/HammingMatch/PIPE_UNROLL.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL -o HammingMatch_rtl.cpp \
		--hls_module=HammingMatch --hls_config=PIPE_UNROLL --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_PIPE_UNROLL))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_HammingMatch_PIPE_UNROLL))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_HammingMatch_PIPE_UNROLL))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_HammingMatch_PIPE_UNROLL) \
		 ../HammingMatch.cpp)))
	
	
	
	

else

$(BDW_HammingMatch_PIPE_UNROLL_HLS_SPEC_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.HammingMatch.PIPE_UNROLL_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_HammingMatch_PIPE_UNROLL_HLS_SPEC_TARGETS))

endif

	

