endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch.d :  ../HammingMatch.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config PIPE_UNROLL of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_HammingMatch_PIPE_UNROLL)  ../HammingMatch.cpp \
	| sed 's|HammingMatch\.o[ :]*|$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_rtl.cpp $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_beh.o $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/debug/HammingMatch_beh.o $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch.d :  |' $(BDW_DEP_FILTER)  > $@

