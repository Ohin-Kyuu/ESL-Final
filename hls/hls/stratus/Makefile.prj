##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/HammingMatch/PIPE4"
##############################################################

HammingMatch_PIPE4_SRCDIR = $(BDW_WORKLIB)/modules/HammingMatch/PIPE4
HammingMatch_PIPE4_BEH_SRCDIR = $(BDW_WORKLIB)/libs/HammingMatch_PIPE4
HammingMatch_PIPE4_LIBNAME = HammingMatch_PIPE4
HammingMatch_PIPE4_WORKLIB = $(BDW_WORKLIB)/modules/HammingMatch/PIPE4
HammingMatch_PIPE4_C_PARTS_A = $(HammingMatch_PIPE4_WORKLIB)/objs/libHammingMatch_PIPE4.a

prep_c_HammingMatch_PIPE4 : $(HammingMatch_PIPE4_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE4_WORKLIB) prep_c

prep_c_HammingMatch_PIPE4_% : $(HammingMatch_PIPE4_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE4_WORKLIB)_$(*F) prep_c

prep_vlog_HammingMatch_PIPE4 : $(HammingMatch_PIPE4_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE4_WORKLIB) prep_vlog

prep_vlog_HammingMatch_PIPE4_% : $(HammingMatch_PIPE4_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE4_WORKLIB)_$(*F) prep_vlog

prep_HammingMatch_PIPE4 : $(HammingMatch_PIPE4_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE4_WORKLIB) prep

prep_HammingMatch_PIPE4_% : $(HammingMatch_PIPE4_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE4_WORKLIB)_$(*F) prep

$(HammingMatch_PIPE4_WORKLIB)/Makefile : $(HammingMatch_PIPE4_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(HammingMatch_PIPE4_WORKLIB) ]; then mkdir -p $(HammingMatch_PIPE4_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim builtin -lib $(HammingMatch_PIPE4_SRCDIR) -o $(HammingMatch_PIPE4_WORKLIB)/Makefile -module HammingMatch -cynthconfig PIPE4   

$(HammingMatch_PIPE4_WORKLIB)_%/Makefile : $(HammingMatch_PIPE4_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(HammingMatch_PIPE4_WORKLIB)_$(*F) ]; then mkdir -p $(HammingMatch_PIPE4_WORKLIB)_$(*F); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim builtin -lib $(HammingMatch_PIPE4_SRCDIR)_$(*F) -o $(HammingMatch_PIPE4_WORKLIB)_$(*F)/Makefile -module HammingMatch -cynthconfig PIPE4_$(*F)   

$(HammingMatch_PIPE4_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(HammingMatch_PIPE4_WORKLIB) ]; then mkdir -p $(HammingMatch_PIPE4_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi

$(HammingMatch_PIPE4_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(HammingMatch_PIPE4_WORKLIB)_$(*F) ]; then mkdir -p $(HammingMatch_PIPE4_WORKLIB)_$(*F); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(HammingMatch_PIPE4_WORKLIB)/HammingMatch_PIPE4.d :
	@if [ ! -d $(HammingMatch_PIPE4_WORKLIB) ]; then mkdir -p $(HammingMatch_PIPE4_WORKLIB); fi
	@touch $(HammingMatch_PIPE4_WORKLIB)/HammingMatch_PIPE4.d



#
# HLS config PIPE_UNROLL
#

#
#	stratus_hls rule
#
LIB_DIRS_HammingMatch_PIPE_UNROLL = 
LIB_INCLUDES_HammingMatch_PIPE_UNROLL = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_PIPE_UNROLL))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_HammingMatch_PIPE_UNROLL = 
