	@$(MAKE)  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl HammingMatch`
	$(subst /PIPE_UNROLL/,/PIPE_UNROLL$(BDW_SPEC_SUF)/,$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/ -I./ $(CCFLAGS_HammingMatch_PIPE_UNROLL) $(EXTRACT_LIB_DASHI_HammingMatch_PIPE_UNROLL) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_rtl.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp)

$(subst /PIPE_UNROLL/,/PIPE_UNROLL$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/debug/HammingMatch_rtl.o) : $(subst /PIPE_UNROLL/,/PIPE_UNROLL$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_rtl.cpp) $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(subst /PIPE_UNROLL/,/PIPE_UNROLL$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl HammingMatch`
	$(subst /PIPE_UNROLL/,/PIPE_UNROLL$(BDW_SPEC_SUF)/,$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/ -I./ $(CCFLAGS_HammingMatch_PIPE_UNROLL) $(EXTRACT_LIB_DASHI_HammingMatch_PIPE_UNROLL) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/debug/HammingMatch_rtl.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp)

#
