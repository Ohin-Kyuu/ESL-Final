	$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/ -I./ $(CCFLAGS_HammingMatch_PIPE1) $(EXTRACT_LIB_DASHI_HammingMatch_PIPE1) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/debug/HammingMatch_rtl.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp

