	@bdw_kill -job hls.HammingMatch.PIPE2_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),PIPE2)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch.d
                BDW_LIB_DEPS = 
            endif
        endif
    endif
