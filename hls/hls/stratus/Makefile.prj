ifneq ($(BDW_SPEC_NAME),)
#
#	RTL object file rule
#
$(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.o) : $(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.cpp) $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl HammingMatch`
	$(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/DPO/ -I./ $(CCFLAGS_HammingMatch_DPO) $(EXTRACT_LIB_DASHI_HammingMatch_DPO) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp)

$(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/debug/HammingMatch_rtl.o) : $(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.cpp) $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_trace.h)
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl HammingMatch`
	$(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/DPO/ -I./ $(CCFLAGS_HammingMatch_DPO) $(EXTRACT_LIB_DASHI_HammingMatch_DPO) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/HammingMatch/DPO/debug/HammingMatch_rtl.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp)

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_beh.o) :  ../HammingMatch.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.h $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/HammingMatch_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/DPO -I./ $(CCFLAGS_BEH_HammingMatch_DPO) -o $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_beh.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp)

$(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/debug/HammingMatch_beh.o) :  ../HammingMatch.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.h $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/HammingMatch_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/DPO -I./ $(CCFLAGS_BEH_HammingMatch_DPO) -o $(BDW_WORKLIB)/modules/HammingMatch/DPO/debug/HammingMatch_beh.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp)

#
# Cosim object file rule
#

$(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch.o) :  ../HammingMatch.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.h $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/HammingMatch_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/DPO -I./ $(CCFLAGS_COSIM_HammingMatch_DPO) -o $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp)
    

$(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_hoist.o) :  ../HammingMatch.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/HammingMatch_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/DPO -I./ $(CCFLAGS_HammingMatch_DPO) $(EXTRACT_LIB_DASHI_HammingMatch_DPO) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_hoist.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp)
    

$(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/debug/HammingMatch.o) :  ../HammingMatch.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.h $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/HammingMatch_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/DPO -I./ $(CCFLAGS_COSIM_HammingMatch_DPO) -o $(BDW_WORKLIB)/modules/HammingMatch/DPO/debug/HammingMatch.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp)


$(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/HammingMatch/DPO/debug/HammingMatch_hoist.o) :  ../HammingMatch.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/HammingMatch_trace.h)
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(subst /DPO/,/DPO$(BDW_SPEC_SUF)/,$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/DPO -I./ $(CCFLAGS_HammingMatch_DPO) $(EXTRACT_LIB_DASHI_HammingMatch_DPO) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/HammingMatch/DPO/debug/HammingMatch_hoist.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp)
    
endif

#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch.d :  ../HammingMatch.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config DPO of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_HammingMatch_DPO)  ../HammingMatch.cpp \
	| sed 's|HammingMatch\.o[ :]*|$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.cpp $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_beh.o $(BDW_WORKLIB)/modules/HammingMatch/DPO/debug/HammingMatch_beh.o $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch.d :  |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/HammingMatch/DPO"
##############################################################

HammingMatch_DPO_SRCDIR = $(BDW_WORKLIB)/modules/HammingMatch/DPO
HammingMatch_DPO_BEH_SRCDIR = $(BDW_WORKLIB)/libs/HammingMatch_DPO
HammingMatch_DPO_LIBNAME = HammingMatch_DPO
HammingMatch_DPO_WORKLIB = $(BDW_WORKLIB)/modules/HammingMatch/DPO
HammingMatch_DPO_C_PARTS_A = $(HammingMatch_DPO_WORKLIB)/objs/libHammingMatch_DPO.a

prep_c_HammingMatch_DPO : $(HammingMatch_DPO_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_DPO_WORKLIB) prep_c

prep_c_HammingMatch_DPO_% : $(HammingMatch_DPO_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_DPO_WORKLIB)_$(*F) prep_c

prep_vlog_HammingMatch_DPO : $(HammingMatch_DPO_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_DPO_WORKLIB) prep_vlog

prep_vlog_HammingMatch_DPO_% : $(HammingMatch_DPO_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_DPO_WORKLIB)_$(*F) prep_vlog

prep_HammingMatch_DPO : $(HammingMatch_DPO_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_DPO_WORKLIB) prep

prep_HammingMatch_DPO_% : $(HammingMatch_DPO_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_DPO_WORKLIB)_$(*F) prep

$(HammingMatch_DPO_WORKLIB)/Makefile : $(HammingMatch_DPO_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(HammingMatch_DPO_WORKLIB) ]; then mkdir -p $(HammingMatch_DPO_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim builtin -lib $(HammingMatch_DPO_SRCDIR) -o $(HammingMatch_DPO_WORKLIB)/Makefile -module HammingMatch -cynthconfig DPO   

$(HammingMatch_DPO_WORKLIB)_%/Makefile : $(HammingMatch_DPO_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(HammingMatch_DPO_WORKLIB)_$(*F) ]; then mkdir -p $(HammingMatch_DPO_WORKLIB)_$(*F); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim builtin -lib $(HammingMatch_DPO_SRCDIR)_$(*F) -o $(HammingMatch_DPO_WORKLIB)_$(*F)/Makefile -module HammingMatch -cynthconfig DPO_$(*F)   

$(HammingMatch_DPO_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(HammingMatch_DPO_WORKLIB) ]; then mkdir -p $(HammingMatch_DPO_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi

$(HammingMatch_DPO_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(HammingMatch_DPO_WORKLIB)_$(*F) ]; then mkdir -p $(HammingMatch_DPO_WORKLIB)_$(*F); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(HammingMatch_DPO_WORKLIB)/HammingMatch_DPO.d :
	@if [ ! -d $(HammingMatch_DPO_WORKLIB) ]; then mkdir -p $(HammingMatch_DPO_WORKLIB); fi
	@touch $(HammingMatch_DPO_WORKLIB)/HammingMatch_DPO.d



#
# HLS config UNROLL
#

#
#	stratus_hls rule
#
LIB_DIRS_HammingMatch_UNROLL = 
LIB_INCLUDES_HammingMatch_UNROLL = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_UNROLL))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_HammingMatch_UNROLL = 
LIB_NAMES_FOR_VLOG_HammingMatch_UNROLL = 
PREFIXED_LIB_NAMES_HammingMatch_UNROLL = 
EXTRACT_LIB_DASHI_HammingMatch_UNROLL = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl HammingMatch UNROLL]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_HammingMatch_UNROLL = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/c_parts -DUNROLL=1 -DBDW_RTL_HammingMatch_UNROLL=1  -DUNROLL -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_UNROLL)
CCFLAGS_COSIM_HammingMatch_UNROLL = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/c_parts -DUNROLL=1 -DBDW_RTL_HammingMatch_UNROLL=1  -DUNROLL -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_UNROLL)
CCFLAGS_BEH_HammingMatch_UNROLL = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/c_parts -DUNROLL=1  -DUNROLL -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_UNROLL)
CCFLAGS_HammingMatch_UNROLL += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_HammingMatch_UNROLL += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_HammingMatch_UNROLL += ${BDW_CCFLAGS_TAIL}

hls_HammingMatch_UNROLL : hlsc_HammingMatch_UNROLL

cynth_HammingMatch_UNROLL : hlsc_HammingMatch_UNROLL

elab_HammingMatch_UNROLL : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/UNROLL/stratus_hls.bdr

optim_HammingMatch_UNROLL : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/UNROLL/stratus_hls.bdr

sched_HammingMatch_UNROLL : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/UNROLL/stratus_hls.bdr

.PHONY: hlsc_HammingMatch_UNROLL hls_HammingMatch_UNROLL

hlsc_HammingMatch_UNROLL : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_rtl.cpp BDW_DEP_CYNTH_CONFIG=UNROLL BDW_MODULE=HammingMatch BDW_HLS_CONFIG=UNROLL
else
	@bdw_exec -jobproject project.tcl -job hls.HammingMatch.UNROLL $(MAKE) CWBExec_hls=1 hlsc_HammingMatch_UNROLL
endif

clean_cynth_HammingMatch_UNROLL: clean_hls_HammingMatch_UNROLL

clean_HammingMatch_UNROLL: clean_hls_HammingMatch_UNROLL

clean_hls_HammingMatch_UNROLL:
	@rm -rf $(BDW_WORKLIB)/modules/HammingMatch/UNROLL
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.UNROLL
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.UNROLL.s

kill_hls_HammingMatch_UNROLL:
	@bdw_kill -job hls.HammingMatch.UNROLL
	@bdw_kill -job hls.HammingMatch.UNROLL.s


hls_HammingMatch_UNROLL_% : hlsc_HammingMatch_UNROLL_%

cynth_HammingMatch_UNROLL_% : hlsc_HammingMatch_UNROLL_%

elab_HammingMatch_UNROLL_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(subst /UNROLL/,/UNROLL_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/stratus_hls.bdr)

optim_HammingMatch_UNROLL_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(subst /UNROLL/,/UNROLL_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/stratus_hls.bdr)

sched_HammingMatch_UNROLL_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(subst /UNROLL/,/UNROLL_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/stratus_hls.bdr)

.PHONY: hlsc_HammingMatch_UNROLL_% hls_HammingMatch_UNROLL_%

hlsc_HammingMatch_UNROLL_% hls_HammingMatch_UNROLL_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /UNROLL/,/UNROLL_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_rtl.cpp) BDW_DEP_CYNTH_CONFIG=UNROLL BDW_MODULE=HammingMatch BDW_HLS_CONFIG=UNROLL_$(*F)
else
	@bdw_exec -jobproject project.tcl -job hls.HammingMatch.UNROLL_$(*F) $(MAKE) CWBExec_hls=1 hlsc_HammingMatch_UNROLL_$(*F)
endif

clean_cynth_HammingMatch_UNROLL_%: clean_hls_HammingMatch_UNROLL_%

clean_HammingMatch_UNROLL_%: clean_hls_HammingMatch_UNROLL_%

clean_hls_HammingMatch_UNROLL_%:
	@rm -rf $(BDW_WORKLIB)/modules/HammingMatch/UNROLL_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.UNROLL_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.UNROLL_$(*F).s

kill_hls_HammingMatch_UNROLL_%:
	@bdw_kill -job hls.HammingMatch.UNROLL_$(*F)
	@bdw_kill -job hls.HammingMatch.UNROLL_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),UNROLL)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch.d
                BDW_LIB_DEPS = 
            endif
        endif
    endif
endif


html_HammingMatch_UNROLL :
	bdw_htmlgen -project project.tcl -module HammingMatch -cynthconfig UNROLL

BDW_HammingMatch_UNROLL_HLS_TARGETS = $(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_rtl.cpp $(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_rtl.v $(BDW_WORKLIB)/modules/HammingMatch/UNROLL/stratus_hls.bdr
BDW_HammingMatch_UNROLL_HLS_SPEC_TARGETS = $(subst /UNROLL/,/UNROLL_%/,$(BDW_HammingMatch_UNROLL_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_HammingMatch_UNROLL_HLS_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/HammingMatch/UNROLL ]; then mkdir -p $(BDW_WORKLIB)/modules/HammingMatch/UNROLL; fi
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=UNROLL BDW_CYNTH_CONFIG=UNROLL \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_rtl.cpp \
		BDW_MODULE=HammingMatch \
		BDW_CYNTH_CONFIG=UNROLL \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/UNROLL \
		BDW_HLS_CONFIG=UNROLL \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/UNROLL \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_HammingMatch_UNROLL) \
		-d $(BDW_WORKLIB)/modules/HammingMatch/UNROLL -o HammingMatch_rtl.cpp \
		--hls_module=HammingMatch --hls_config=UNROLL --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_UNROLL))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_HammingMatch_UNROLL))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_HammingMatch_UNROLL))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_HammingMatch_UNROLL) \
		 ../HammingMatch.cpp
	
	
	
	

else

$(BDW_HammingMatch_UNROLL_HLS_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.HammingMatch.UNROLL.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_HammingMatch_UNROLL_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_trace.h : $(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_trace.h.updated

$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_trace.h.updated : $(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module HammingMatch -cynthconfig UNROLL  
	@touch $(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_HammingMatch_UNROLL_HLS_SPEC_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/HammingMatch/UNROLL_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/HammingMatch/UNROLL_$(*F); fi
	
	$(subst /UNROLL ,/UNROLL_$(*F) ,$(subst =UNROLL ,=UNROLL_$(*F) ,$(subst /HammingMatch/UNROLL/,/HammingMatch/UNROLL_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=UNROLL BDW_CYNTH_CONFIG=UNROLL \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_rtl.cpp \
		BDW_MODULE=HammingMatch \
		BDW_CYNTH_CONFIG=UNROLL \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/UNROLL \
		BDW_HLS_CONFIG=UNROLL \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/UNROLL \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_HammingMatch_UNROLL) \
		`cat  $(BDW_SPECLIB)/HammingMatch/UNROLL.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/HammingMatch/UNROLL -o HammingMatch_rtl.cpp \
		--hls_module=HammingMatch --hls_config=UNROLL --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_UNROLL))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_HammingMatch_UNROLL))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_HammingMatch_UNROLL))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_HammingMatch_UNROLL) \
		 ../HammingMatch.cpp)))
	
	
	
	

else

$(BDW_HammingMatch_UNROLL_HLS_SPEC_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.HammingMatch.UNROLL_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_HammingMatch_UNROLL_HLS_SPEC_TARGETS))

endif

	

$(subst /UNROLL/,/UNROLL_%/,$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_trace.h) : $(subst /UNROLL/,/UNROLL_%/,$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module HammingMatch -cynthconfig UNROLL_$(*F)  

catHLLog_HammingMatch_UNROLL:
	cat $(BDW_WORKLIB)/modules/HammingMatch/UNROLL/stratus_hls.log

#
#	stratus_vlg rule
#
cynthvlg_HammingMatch_UNROLL : hls_HammingMatch_UNROLL 


.PHONY: hls_HammingMatch_UNROLL

hls_HammingMatch_UNROLL hlsv_HammingMatch_UNROLL: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_HammingMatch_UNROLL)) 
ifeq ($(CWBExec_hlsv),1)
	@$(MAKE)  prep_vlog_HammingMatch_UNROLL BDW_DEP_CYNTH_CONFIG=UNROLL
else
	@bdw_exec -jobproject project.tcl -job hlsv.HammingMatch.UNROLL $(MAKE) CWBExec_hlsv=1 hlsv_HammingMatch_UNROLL
endif

.PHONY: hls_HammingMatch_UNROLL

hls_HammingMatch_UNROLL_% hlsv_HammingMatch_UNROLL_%: $(addprefix prep_vlog_,$(LIB_NAMES_FOR_VLOG_HammingMatch_UNROLL)) 
ifeq ($(CWBExec_hlsv),1)
	@$(MAKE)  prep_vlog_HammingMatch_UNROLL BDW_DEP_CYNTH_CONFIG=UNROLL
else
	@bdw_exec -jobproject project.tcl -job hlsv.HammingMatch.UNROLL_$(*F) $(MAKE) CWBExec_hlsv=1 hlsv_HammingMatch_UNROLL_$(*F)
endif

