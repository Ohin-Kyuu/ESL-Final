$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_hoist.o :  ../HammingMatch.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(BDW_WORKLIB)/wrappers/HammingMatch_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/DPO -I./ $(CCFLAGS_HammingMatch_DPO) $(EXTRACT_LIB_DASHI_HammingMatch_DPO) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_hoist.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp
    

$(BDW_WORKLIB)/modules/HammingMatch/DPO/debug/HammingMatch.o :  ../HammingMatch.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.h $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(BDW_WORKLIB)/wrappers/HammingMatch_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/DPO -I./ $(CCFLAGS_COSIM_HammingMatch_DPO) -o $(BDW_WORKLIB)/modules/HammingMatch/DPO/debug/HammingMatch.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp


$(BDW_WORKLIB)/modules/HammingMatch/DPO/debug/HammingMatch_hoist.o :  ../HammingMatch.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(BDW_WORKLIB)/wrappers/HammingMatch_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/DPO -I./ $(CCFLAGS_HammingMatch_DPO) $(EXTRACT_LIB_DASHI_HammingMatch_DPO) -DBDW_HOIST -o $(BDW_WORKLIB)/modules/HammingMatch/DPO/debug/HammingMatch_hoist.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp
    

