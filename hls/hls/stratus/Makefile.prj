PREFIXED_LIB_NAMES_HammingMatch_PIPE_UNROLL = 
EXTRACT_LIB_DASHI_HammingMatch_PIPE_UNROLL = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl HammingMatch PIPE_UNROLL]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_HammingMatch_PIPE_UNROLL = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/c_parts -DPIPE_UNROLL=1 -DBDW_RTL_HammingMatch_PIPE_UNROLL=1  -DUNROLL -DPIPELINE -DII=2 -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_PIPE_UNROLL)
CCFLAGS_COSIM_HammingMatch_PIPE_UNROLL = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/c_parts -DPIPE_UNROLL=1 -DBDW_RTL_HammingMatch_PIPE_UNROLL=1  -DUNROLL -DPIPELINE -DII=2 -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_PIPE_UNROLL)
CCFLAGS_BEH_HammingMatch_PIPE_UNROLL = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/c_parts -DPIPE_UNROLL=1  -DUNROLL -DPIPELINE -DII=2 -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_PIPE_UNROLL)
CCFLAGS_HammingMatch_PIPE_UNROLL += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_HammingMatch_PIPE_UNROLL += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_HammingMatch_PIPE_UNROLL += ${BDW_CCFLAGS_TAIL}

