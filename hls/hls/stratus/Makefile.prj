## Start of the "ALL" rule set
#########################################################

pnr_all:


kill_pnr_all:


clean_pnr_all:


power_all:


kill_power_all:


clean_power_all:


equiv_all:


kill_equiv_all:


clean_equiv_all:


ls_all:


kill_ls_all:


clean_ls_all:


analysis_all:


kill_analysis_all:


clean_analysis_all:


hls_sim_all: hls_B hls_V_BASIC hls_V_DPO hls_V_UNROLL hls_V_PIPE1 hls_V_PIPE2 hls_V_PIPE4 hls_V_PIPE_UNROLL


cov_all:


kill_cov_all:


clean_cov_all:


hls_all: hls_HammingMatch_BASIC hls_HammingMatch_DPO hls_HammingMatch_UNROLL hls_HammingMatch_PIPE1 hls_HammingMatch_PIPE2 hls_HammingMatch_PIPE4 hls_HammingMatch_PIPE_UNROLL


hls_HammingMatch_all: hls_HammingMatch_BASIC hls_HammingMatch_DPO hls_HammingMatch_UNROLL hls_HammingMatch_PIPE1 hls_HammingMatch_PIPE2 hls_HammingMatch_PIPE4 hls_HammingMatch_PIPE_UNROLL


cynth_all: cynth_B cynth_V_BASIC cynth_V_DPO cynth_V_UNROLL cynth_V_PIPE1 cynth_V_PIPE2 cynth_V_PIPE4 cynth_V_PIPE_UNROLL


kill_hls_all kill_cynth_all: kill_hls_HammingMatch_BASIC kill_hls_HammingMatch_DPO kill_hls_HammingMatch_UNROLL kill_hls_HammingMatch_PIPE1 kill_hls_HammingMatch_PIPE2 kill_hls_HammingMatch_PIPE4 kill_hls_HammingMatch_PIPE_UNROLL


gen_all_deps: 
ifneq ($(BDW_DEP_FILES),)
	-@$(MAKE) $(BDW_DEP_FILES)
endif


.PHONY: gen_all_deps
.PHONY: all_deps


all_wrappers : bdw_prebuild_wrappers

bdw_prebuild_wrappers: 
ifneq ($(BDW_ALL_WRAPPERS),)
	@$(MAKE) -j 1 $(BDW_ALL_WRAPPERS)
endif

bdw_prebuild_rtl:
ifneq ($(SIM_RTL_TARGETS),)
ifneq ($(BDW_SPEC_NAME),)
	@$(MAKE) `$(BDW_SPEC_FILTER) project.db $(BDW_SPEC_ARG) $(SIM_RTL_TARGETS)`
else
	@$(MAKE) $(SIM_RTL_TARGETS)
endif
endif

.PHONY: bdw_prebuild_sim_objs

bdw_prebuild_sim_objs:
ifneq ($(SIM_OBJS),)
ifneq ($(BDW_SPEC_NAME),)
	@$(MAKE) `$(BDW_SPEC_FILTER) project.db $(BDW_SPEC_ARG) $(SIM_OBJS)`
else
	@$(MAKE) $(SIM_OBJS)
endif
endif


clean_hls_all: clean_hls_B clean_hls_V_BASIC clean_hls_V_DPO clean_hls_V_UNROLL clean_hls_V_PIPE1 clean_hls_V_PIPE2 clean_hls_V_PIPE4 clean_hls_V_PIPE_UNROLL

hls_clean_all: clean_hls_all
cynth_clean_all: clean_hls_all
clean_cynth_all: clean_hls_all
prebuild_all: prebuild_B prebuild_V_BASIC prebuild_V_DPO prebuild_V_UNROLL prebuild_V_PIPE1 prebuild_V_PIPE2 prebuild_V_PIPE4 prebuild_V_PIPE_UNROLL

build_all: build_B build_V_BASIC build_V_DPO build_V_UNROLL build_V_PIPE1 build_V_PIPE2 build_V_PIPE4 build_V_PIPE_UNROLL

sim_all: sim_B sim_V_BASIC sim_V_DPO sim_V_UNROLL sim_V_PIPE1 sim_V_PIPE2 sim_V_PIPE4 sim_V_PIPE_UNROLL

kill_sim_all: kill_sim_B kill_sim_V_BASIC kill_sim_V_DPO kill_sim_V_UNROLL kill_sim_V_PIPE1 kill_sim_V_PIPE2 kill_sim_V_PIPE4 kill_sim_V_PIPE_UNROLL

clean_wrap_all:
	@rm -fr $(BDW_WORKLIB)/wrappers

clean_spec_%:
	@$(BDW_SPEC_CLEAN) $(*F) -prefix

delete_spec_%:
	@$(BDW_SPEC_DELETE) $(*F) -prefix

kill_all: 
	@bdw_kill -all


clean_cachelib:
	@rm -rf /home/u111/u111033238/workspace/ee6470/stratus/hw/hls/stratus/cachelib

clean_all:
	@if [ -d $(BDW_WORKLIB) ] ; then \
		td=`mktemp -d $(BDW_WORKLIB).XXXXXXXX` ; \
		mv $(BDW_WORKLIB) $${td} ; \
		for f in *.vcd *.fsdb ; do \
			if [ -f $$f ] ; then \
				mv $$f $${td} ; \
			fi ; \
		done ; \
		rm -rf $${td} & \
	fi

clean_sim_all: clean_B clean_V_BASIC clean_V_DPO clean_V_UNROLL clean_V_PIPE1 clean_V_PIPE2 clean_V_PIPE4 clean_V_PIPE_UNROLL clean_deps
	@rm -rf *.vcd *.fsdb $(BDW_OBJDIR) $(BDW_SIMDIR) $(BDW_MODULEDIR) $(BDW_WRAPDIR)

jobs:
	@bdw_ps

clean_libs:
	@rm -rf $(BDW_LIBDIR)

clean_deps:
	@if [ -d $(BDW_WORKLIB) ]; then find $(BDW_WORKLIB) -type f -name '*.d' -exec rm {} \; ; fi

deps : $(DEP_FILES)

