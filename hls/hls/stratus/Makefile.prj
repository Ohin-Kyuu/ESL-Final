	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE1_WORKLIB)_$(*F) prep_vlog

prep_HammingMatch_PIPE1 : $(HammingMatch_PIPE1_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE1_WORKLIB) prep

prep_HammingMatch_PIPE1_% : $(HammingMatch_PIPE1_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE1_WORKLIB)_$(*F) prep

$(HammingMatch_PIPE1_WORKLIB)/Makefile : $(HammingMatch_PIPE1_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(HammingMatch_PIPE1_WORKLIB) ]; then mkdir -p $(HammingMatch_PIPE1_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim builtin -lib $(HammingMatch_PIPE1_SRCDIR) -o $(HammingMatch_PIPE1_WORKLIB)/Makefile -module HammingMatch -cynthconfig PIPE1   

$(HammingMatch_PIPE1_WORKLIB)_%/Makefile : $(HammingMatch_PIPE1_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(HammingMatch_PIPE1_WORKLIB)_$(*F) ]; then mkdir -p $(HammingMatch_PIPE1_WORKLIB)_$(*F); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim builtin -lib $(HammingMatch_PIPE1_SRCDIR)_$(*F) -o $(HammingMatch_PIPE1_WORKLIB)_$(*F)/Makefile -module HammingMatch -cynthconfig PIPE1_$(*F)   

$(HammingMatch_PIPE1_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(HammingMatch_PIPE1_WORKLIB) ]; then mkdir -p $(HammingMatch_PIPE1_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi

$(HammingMatch_PIPE1_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(HammingMatch_PIPE1_WORKLIB)_$(*F) ]; then mkdir -p $(HammingMatch_PIPE1_WORKLIB)_$(*F); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(HammingMatch_PIPE1_WORKLIB)/HammingMatch_PIPE1.d :
	@if [ ! -d $(HammingMatch_PIPE1_WORKLIB) ]; then mkdir -p $(HammingMatch_PIPE1_WORKLIB); fi
	@touch $(HammingMatch_PIPE1_WORKLIB)/HammingMatch_PIPE1.d



#
# HLS config PIPE2
#

#
#	stratus_hls rule
#
LIB_DIRS_HammingMatch_PIPE2 = 
LIB_INCLUDES_HammingMatch_PIPE2 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_PIPE2))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_HammingMatch_PIPE2 = 
LIB_NAMES_FOR_VLOG_HammingMatch_PIPE2 = 
PREFIXED_LIB_NAMES_HammingMatch_PIPE2 = 
EXTRACT_LIB_DASHI_HammingMatch_PIPE2 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl HammingMatch PIPE2]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_HammingMatch_PIPE2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE2/c_parts -DPIPE2=1 -DBDW_RTL_HammingMatch_PIPE2=1  -DPIPELINE -DII=2 -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_PIPE2)
CCFLAGS_COSIM_HammingMatch_PIPE2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE2/c_parts -DPIPE2=1 -DBDW_RTL_HammingMatch_PIPE2=1  -DPIPELINE -DII=2 -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_PIPE2)
CCFLAGS_BEH_HammingMatch_PIPE2 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE2/c_parts -DPIPE2=1  -DPIPELINE -DII=2 -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_PIPE2)
CCFLAGS_HammingMatch_PIPE2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_HammingMatch_PIPE2 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_HammingMatch_PIPE2 += ${BDW_CCFLAGS_TAIL}

hls_HammingMatch_PIPE2 : hlsc_HammingMatch_PIPE2

cynth_HammingMatch_PIPE2 : hlsc_HammingMatch_PIPE2

elab_HammingMatch_PIPE2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/PIPE2/stratus_hls.bdr

optim_HammingMatch_PIPE2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/PIPE2/stratus_hls.bdr

sched_HammingMatch_PIPE2 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/PIPE2/stratus_hls.bdr

