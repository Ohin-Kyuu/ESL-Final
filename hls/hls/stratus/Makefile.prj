	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl HammingMatch`
	$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE2/ -I./ $(CCFLAGS_HammingMatch_PIPE2) $(EXTRACT_LIB_DASHI_HammingMatch_PIPE2) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/HammingMatch/PIPE2/debug/HammingMatch_rtl.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp

