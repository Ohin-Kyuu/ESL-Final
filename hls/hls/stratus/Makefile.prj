$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_rtl.o : $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_rtl.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_trace.h
