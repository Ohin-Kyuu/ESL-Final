##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL"
##############################################################

HammingMatch_PIPE_UNROLL_SRCDIR = $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL
HammingMatch_PIPE_UNROLL_BEH_SRCDIR = $(BDW_WORKLIB)/libs/HammingMatch_PIPE_UNROLL
HammingMatch_PIPE_UNROLL_LIBNAME = HammingMatch_PIPE_UNROLL
HammingMatch_PIPE_UNROLL_WORKLIB = $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL
HammingMatch_PIPE_UNROLL_C_PARTS_A = $(HammingMatch_PIPE_UNROLL_WORKLIB)/objs/libHammingMatch_PIPE_UNROLL.a

prep_c_HammingMatch_PIPE_UNROLL : $(HammingMatch_PIPE_UNROLL_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE_UNROLL_WORKLIB) prep_c

prep_c_HammingMatch_PIPE_UNROLL_% : $(HammingMatch_PIPE_UNROLL_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE_UNROLL_WORKLIB)_$(*F) prep_c

prep_vlog_HammingMatch_PIPE_UNROLL : $(HammingMatch_PIPE_UNROLL_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE_UNROLL_WORKLIB) prep_vlog

prep_vlog_HammingMatch_PIPE_UNROLL_% : $(HammingMatch_PIPE_UNROLL_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE_UNROLL_WORKLIB)_$(*F) prep_vlog

prep_HammingMatch_PIPE_UNROLL : $(HammingMatch_PIPE_UNROLL_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE_UNROLL_WORKLIB) prep

prep_HammingMatch_PIPE_UNROLL_% : $(HammingMatch_PIPE_UNROLL_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE_UNROLL_WORKLIB)_$(*F) prep

$(HammingMatch_PIPE_UNROLL_WORKLIB)/Makefile : $(HammingMatch_PIPE_UNROLL_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(HammingMatch_PIPE_UNROLL_WORKLIB) ]; then mkdir -p $(HammingMatch_PIPE_UNROLL_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim builtin -lib $(HammingMatch_PIPE_UNROLL_SRCDIR) -o $(HammingMatch_PIPE_UNROLL_WORKLIB)/Makefile -module HammingMatch -cynthconfig PIPE_UNROLL   

$(HammingMatch_PIPE_UNROLL_WORKLIB)_%/Makefile : $(HammingMatch_PIPE_UNROLL_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(HammingMatch_PIPE_UNROLL_WORKLIB)_$(*F) ]; then mkdir -p $(HammingMatch_PIPE_UNROLL_WORKLIB)_$(*F); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim builtin -lib $(HammingMatch_PIPE_UNROLL_SRCDIR)_$(*F) -o $(HammingMatch_PIPE_UNROLL_WORKLIB)_$(*F)/Makefile -module HammingMatch -cynthconfig PIPE_UNROLL_$(*F)   

$(HammingMatch_PIPE_UNROLL_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(HammingMatch_PIPE_UNROLL_WORKLIB) ]; then mkdir -p $(HammingMatch_PIPE_UNROLL_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi

$(HammingMatch_PIPE_UNROLL_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(HammingMatch_PIPE_UNROLL_WORKLIB)_$(*F) ]; then mkdir -p $(HammingMatch_PIPE_UNROLL_WORKLIB)_$(*F); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(HammingMatch_PIPE_UNROLL_WORKLIB)/HammingMatch_PIPE_UNROLL.d :
	@if [ ! -d $(HammingMatch_PIPE_UNROLL_WORKLIB) ]; then mkdir -p $(HammingMatch_PIPE_UNROLL_WORKLIB); fi
	@touch $(HammingMatch_PIPE_UNROLL_WORKLIB)/HammingMatch_PIPE_UNROLL.d



