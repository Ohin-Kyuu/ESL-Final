html_HammingMatch_PIPE2 :
	bdw_htmlgen -project project.tcl -module HammingMatch -cynthconfig PIPE2

BDW_HammingMatch_PIPE2_HLS_TARGETS = $(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch_rtl.cpp $(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch_rtl.v $(BDW_WORKLIB)/modules/HammingMatch/PIPE2/stratus_hls.bdr
BDW_HammingMatch_PIPE2_HLS_SPEC_TARGETS = $(subst /PIPE2/,/PIPE2_%/,$(BDW_HammingMatch_PIPE2_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_HammingMatch_PIPE2_HLS_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/HammingMatch/PIPE2 ]; then mkdir -p $(BDW_WORKLIB)/modules/HammingMatch/PIPE2; fi
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE2 BDW_CYNTH_CONFIG=PIPE2 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch_rtl.cpp \
		BDW_MODULE=HammingMatch \
		BDW_CYNTH_CONFIG=PIPE2 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/PIPE2 \
		BDW_HLS_CONFIG=PIPE2 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/PIPE2 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_HammingMatch_PIPE2) \
		-d $(BDW_WORKLIB)/modules/HammingMatch/PIPE2 -o HammingMatch_rtl.cpp \
		--hls_module=HammingMatch --hls_config=PIPE2 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_PIPE2))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_HammingMatch_PIPE2))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_HammingMatch_PIPE2))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_HammingMatch_PIPE2) \
		 ../HammingMatch.cpp
	
	
	
	

else

$(BDW_HammingMatch_PIPE2_HLS_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.HammingMatch.PIPE2.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_HammingMatch_PIPE2_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch_trace.h : $(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch_trace.h.updated

$(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch_trace.h.updated : $(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module HammingMatch -cynthconfig PIPE2  
	@touch $(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_HammingMatch_PIPE2_HLS_SPEC_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/HammingMatch/PIPE2_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/HammingMatch/PIPE2_$(*F); fi
	
	$(subst /PIPE2 ,/PIPE2_$(*F) ,$(subst =PIPE2 ,=PIPE2_$(*F) ,$(subst /HammingMatch/PIPE2/,/HammingMatch/PIPE2_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE2 BDW_CYNTH_CONFIG=PIPE2 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch_rtl.cpp \
		BDW_MODULE=HammingMatch \
		BDW_CYNTH_CONFIG=PIPE2 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/PIPE2 \
		BDW_HLS_CONFIG=PIPE2 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/PIPE2 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_HammingMatch_PIPE2) \
		`cat  $(BDW_SPECLIB)/HammingMatch/PIPE2.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/HammingMatch/PIPE2 -o HammingMatch_rtl.cpp \
		--hls_module=HammingMatch --hls_config=PIPE2 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_PIPE2))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_HammingMatch_PIPE2))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_HammingMatch_PIPE2))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_HammingMatch_PIPE2) \
		 ../HammingMatch.cpp)))
	
	
	
	

else

$(BDW_HammingMatch_PIPE2_HLS_SPEC_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.HammingMatch.PIPE2_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_HammingMatch_PIPE2_HLS_SPEC_TARGETS))

endif

	

$(subst /PIPE2/,/PIPE2_%/,$(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch_trace.h) : $(subst /PIPE2/,/PIPE2_%/,$(BDW_WORKLIB)/modules/HammingMatch/PIPE2/HammingMatch_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
