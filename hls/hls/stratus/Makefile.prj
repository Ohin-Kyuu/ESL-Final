$(subst /PIPE_UNROLL/,/PIPE_UNROLL$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/debug/HammingMatch.o) :  ../HammingMatch.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.h $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(subst /PIPE_UNROLL/,/PIPE_UNROLL$(BDW_SPEC_SUF)/,$(BDW_WORKLIB)/wrappers/HammingMatch_trace.h)
