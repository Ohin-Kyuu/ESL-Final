#
#	view rule
#

view_HammingMatch_DPO:
	@echo "ERROR: Schematic viewing target 'view_HammingMatch_DPO' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.o : $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl HammingMatch`
	$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/DPO/ -I./ $(CCFLAGS_HammingMatch_DPO) $(EXTRACT_LIB_DASHI_HammingMatch_DPO) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp

$(BDW_WORKLIB)/modules/HammingMatch/DPO/debug/HammingMatch_rtl.o : $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_rtl.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl HammingMatch`
	$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/DPO/ -I./ $(CCFLAGS_HammingMatch_DPO) $(EXTRACT_LIB_DASHI_HammingMatch_DPO) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/HammingMatch/DPO/debug/HammingMatch_rtl.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp

#
#	Behavioral object file rule.  Used only for BEH configs that are 
#	associated with HLS config names.
#

$(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_beh.o :  ../HammingMatch.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.h $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(BDW_WORKLIB)/wrappers/HammingMatch_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/DPO -I./ $(CCFLAGS_BEH_HammingMatch_DPO) -o $(BDW_WORKLIB)/modules/HammingMatch/DPO/HammingMatch_beh.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp

$(BDW_WORKLIB)/modules/HammingMatch/DPO/debug/HammingMatch_beh.o :  ../HammingMatch.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.h $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(BDW_WORKLIB)/wrappers/HammingMatch_trace.h
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/DPO -I./ $(CCFLAGS_BEH_HammingMatch_DPO) -o $(BDW_WORKLIB)/modules/HammingMatch/DPO/debug/HammingMatch_beh.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp

