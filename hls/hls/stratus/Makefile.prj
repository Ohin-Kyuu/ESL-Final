## Parts Library "$(BDW_WORKLIB)/modules/HammingMatch/PIPE2"
##############################################################

HammingMatch_PIPE2_SRCDIR = $(BDW_WORKLIB)/modules/HammingMatch/PIPE2
HammingMatch_PIPE2_BEH_SRCDIR = $(BDW_WORKLIB)/libs/HammingMatch_PIPE2
HammingMatch_PIPE2_LIBNAME = HammingMatch_PIPE2
HammingMatch_PIPE2_WORKLIB = $(BDW_WORKLIB)/modules/HammingMatch/PIPE2
HammingMatch_PIPE2_C_PARTS_A = $(HammingMatch_PIPE2_WORKLIB)/objs/libHammingMatch_PIPE2.a

prep_c_HammingMatch_PIPE2 : $(HammingMatch_PIPE2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE2_WORKLIB) prep_c

prep_c_HammingMatch_PIPE2_% : $(HammingMatch_PIPE2_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE2_WORKLIB)_$(*F) prep_c

prep_vlog_HammingMatch_PIPE2 : $(HammingMatch_PIPE2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE2_WORKLIB) prep_vlog

prep_vlog_HammingMatch_PIPE2_% : $(HammingMatch_PIPE2_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE2_WORKLIB)_$(*F) prep_vlog

prep_HammingMatch_PIPE2 : $(HammingMatch_PIPE2_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE2_WORKLIB) prep

prep_HammingMatch_PIPE2_% : $(HammingMatch_PIPE2_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_PIPE2_WORKLIB)_$(*F) prep

$(HammingMatch_PIPE2_WORKLIB)/Makefile : $(HammingMatch_PIPE2_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(HammingMatch_PIPE2_WORKLIB) ]; then mkdir -p $(HammingMatch_PIPE2_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim builtin -lib $(HammingMatch_PIPE2_SRCDIR) -o $(HammingMatch_PIPE2_WORKLIB)/Makefile -module HammingMatch -cynthconfig PIPE2   

$(HammingMatch_PIPE2_WORKLIB)_%/Makefile : $(HammingMatch_PIPE2_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(HammingMatch_PIPE2_WORKLIB)_$(*F) ]; then mkdir -p $(HammingMatch_PIPE2_WORKLIB)_$(*F); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim builtin -lib $(HammingMatch_PIPE2_SRCDIR)_$(*F) -o $(HammingMatch_PIPE2_WORKLIB)_$(*F)/Makefile -module HammingMatch -cynthconfig PIPE2_$(*F)   

$(HammingMatch_PIPE2_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(HammingMatch_PIPE2_WORKLIB) ]; then mkdir -p $(HammingMatch_PIPE2_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi

$(HammingMatch_PIPE2_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(HammingMatch_PIPE2_WORKLIB)_$(*F) ]; then mkdir -p $(HammingMatch_PIPE2_WORKLIB)_$(*F); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(HammingMatch_PIPE2_WORKLIB)/HammingMatch_PIPE2.d :
	@if [ ! -d $(HammingMatch_PIPE2_WORKLIB) ]; then mkdir -p $(HammingMatch_PIPE2_WORKLIB); fi
	@touch $(HammingMatch_PIPE2_WORKLIB)/HammingMatch_PIPE2.d



#
# HLS config PIPE4
#

#
#	stratus_hls rule
#
LIB_DIRS_HammingMatch_PIPE4 = 
LIB_INCLUDES_HammingMatch_PIPE4 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_PIPE4))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_HammingMatch_PIPE4 = 
LIB_NAMES_FOR_VLOG_HammingMatch_PIPE4 = 
PREFIXED_LIB_NAMES_HammingMatch_PIPE4 = 
EXTRACT_LIB_DASHI_HammingMatch_PIPE4 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl HammingMatch PIPE4]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_HammingMatch_PIPE4 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE4/c_parts -DPIPE4=1 -DBDW_RTL_HammingMatch_PIPE4=1  -DPIPELINE -DII=4 -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_PIPE4)
CCFLAGS_COSIM_HammingMatch_PIPE4 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE4/c_parts -DPIPE4=1 -DBDW_RTL_HammingMatch_PIPE4=1  -DPIPELINE -DII=4 -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_PIPE4)
CCFLAGS_BEH_HammingMatch_PIPE4 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE4/c_parts -DPIPE4=1  -DPIPELINE -DII=4 -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_PIPE4)
CCFLAGS_HammingMatch_PIPE4 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_HammingMatch_PIPE4 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_HammingMatch_PIPE4 += ${BDW_CCFLAGS_TAIL}

hls_HammingMatch_PIPE4 : hlsc_HammingMatch_PIPE4

cynth_HammingMatch_PIPE4 : hlsc_HammingMatch_PIPE4

elab_HammingMatch_PIPE4 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/PIPE4/stratus_hls.bdr

optim_HammingMatch_PIPE4 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/PIPE4/stratus_hls.bdr

sched_HammingMatch_PIPE4 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/PIPE4/stratus_hls.bdr

.PHONY: hlsc_HammingMatch_PIPE4 hls_HammingMatch_PIPE4

hlsc_HammingMatch_PIPE4 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/PIPE4/HammingMatch_rtl.cpp BDW_DEP_CYNTH_CONFIG=PIPE4 BDW_MODULE=HammingMatch BDW_HLS_CONFIG=PIPE4
else
	@bdw_exec -jobproject project.tcl -job hls.HammingMatch.PIPE4 $(MAKE) CWBExec_hls=1 hlsc_HammingMatch_PIPE4
endif

clean_cynth_HammingMatch_PIPE4: clean_hls_HammingMatch_PIPE4

clean_HammingMatch_PIPE4: clean_hls_HammingMatch_PIPE4

clean_hls_HammingMatch_PIPE4:
	@rm -rf $(BDW_WORKLIB)/modules/HammingMatch/PIPE4
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.PIPE4
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.PIPE4.s

kill_hls_HammingMatch_PIPE4:
	@bdw_kill -job hls.HammingMatch.PIPE4
	@bdw_kill -job hls.HammingMatch.PIPE4.s


