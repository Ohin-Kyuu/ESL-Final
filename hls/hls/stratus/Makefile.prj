	@$(MAKE) BDW_DEBUG=1 build_B_$(*F)
	@$(MAKE) run_sim BDW_DEBUG=1 BDW_SIM_CONFIG=B_$(*F)  BDW_BASE_SIM_CONFIG=B BDW_SPEC_NAME=$(*F) RUN_DEBUGGER=1
    

