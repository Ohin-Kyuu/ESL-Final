ifeq ($(BDW_DEP_CYNTH_CONFIG),PIPE_UNROLL)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch.d
                BDW_LIB_DEPS = 
            endif
        endif
    endif
