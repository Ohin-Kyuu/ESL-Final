	$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/ -I./ $(CCFLAGS_HammingMatch_PIPE_UNROLL) $(EXTRACT_LIB_DASHI_HammingMatch_PIPE_UNROLL) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/HammingMatch/PIPE_UNROLL/HammingMatch_rtl.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp

