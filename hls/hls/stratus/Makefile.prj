view_HammingMatch_PIPE1:
	@echo "ERROR: Schematic viewing target 'view_HammingMatch_PIPE1' is only supported with 'verdi'"
	@echo "The Stratus IDE includes a schematic view as an alternative."


#
#	RTL object file rule
#
$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_rtl.o : $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_rtl.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_trace.h
	@if [ ! -d $(@D) ] ; then mkdir -p $(@D) ; fi
	@$(MAKE)  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp `$(STRATUS_HOME)/bin/bdw_shell $(BDW_TCL_DIR)/bdw_nestedwrap.tcl project.tcl HammingMatch`
	$(BDW_CC)  -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/ -I./ $(CCFLAGS_HammingMatch_PIPE1) $(EXTRACT_LIB_DASHI_HammingMatch_PIPE1) -DBDW_RTL=1 -DBDW_HUB=1 -o $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_rtl.o  $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp

$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/debug/HammingMatch_rtl.o : $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_rtl.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_wrap.cpp $(BDW_WORKLIB)/wrappers/HammingMatch_cosim.h $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_trace.h
