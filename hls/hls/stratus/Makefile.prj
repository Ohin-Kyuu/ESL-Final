#
#	Dependency generation rule
#
$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch.d :  ../HammingMatch.cpp
	@if [ ! -d $(@D) ]; then mkdir -p $(@D); fi
	@echo "Generating dependencies for HLS config UNROLL of "$<
	@set -e; $(BDW_CCDEP) -MM -MG $(CCFLAGS_HammingMatch_UNROLL)  ../HammingMatch.cpp \
	| sed 's|HammingMatch\.o[ :]*|$(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_rtl.cpp $(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch_beh.o $(BDW_WORKLIB)/modules/HammingMatch/UNROLL/debug/HammingMatch_beh.o $(BDW_WORKLIB)/modules/HammingMatch/UNROLL/HammingMatch.d :  |' $(BDW_DEP_FILTER)  > $@

#
#	Library post-proc rules
#



##############################################################
## Parts Library "$(BDW_WORKLIB)/modules/HammingMatch/UNROLL"
##############################################################

HammingMatch_UNROLL_SRCDIR = $(BDW_WORKLIB)/modules/HammingMatch/UNROLL
HammingMatch_UNROLL_BEH_SRCDIR = $(BDW_WORKLIB)/libs/HammingMatch_UNROLL
HammingMatch_UNROLL_LIBNAME = HammingMatch_UNROLL
HammingMatch_UNROLL_WORKLIB = $(BDW_WORKLIB)/modules/HammingMatch/UNROLL
HammingMatch_UNROLL_C_PARTS_A = $(HammingMatch_UNROLL_WORKLIB)/objs/libHammingMatch_UNROLL.a

prep_c_HammingMatch_UNROLL : $(HammingMatch_UNROLL_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_UNROLL_WORKLIB) prep_c

prep_c_HammingMatch_UNROLL_% : $(HammingMatch_UNROLL_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_UNROLL_WORKLIB)_$(*F) prep_c

prep_vlog_HammingMatch_UNROLL : $(HammingMatch_UNROLL_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_UNROLL_WORKLIB) prep_vlog

prep_vlog_HammingMatch_UNROLL_% : $(HammingMatch_UNROLL_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_UNROLL_WORKLIB)_$(*F) prep_vlog

prep_HammingMatch_UNROLL : $(HammingMatch_UNROLL_WORKLIB)/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_UNROLL_WORKLIB) prep

prep_HammingMatch_UNROLL_% : $(HammingMatch_UNROLL_WORKLIB)_%/Makefile
	@+make --no-print-directory $(BDW_PMAKE_FLG) -C $(HammingMatch_UNROLL_WORKLIB)_$(*F) prep

$(HammingMatch_UNROLL_WORKLIB)/Makefile : $(HammingMatch_UNROLL_SRCDIR)/stratus_hls.bdl
	@if [ ! -d $(HammingMatch_UNROLL_WORKLIB) ]; then mkdir -p $(HammingMatch_UNROLL_WORKLIB); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim builtin -lib $(HammingMatch_UNROLL_SRCDIR) -o $(HammingMatch_UNROLL_WORKLIB)/Makefile -module HammingMatch -cynthconfig UNROLL   

$(HammingMatch_UNROLL_WORKLIB)_%/Makefile : $(HammingMatch_UNROLL_SRCDIR)_%/stratus_hls.bdl
	@if [ ! -d $(HammingMatch_UNROLL_WORKLIB)_$(*F) ]; then mkdir -p $(HammingMatch_UNROLL_WORKLIB)_$(*F); fi
	$(STRATUS_HOME)/bin/bdw_makegen project.tcl -scsim builtin -lib $(HammingMatch_UNROLL_SRCDIR)_$(*F) -o $(HammingMatch_UNROLL_WORKLIB)_$(*F)/Makefile -module HammingMatch -cynthconfig UNROLL_$(*F)   

$(HammingMatch_UNROLL_SRCDIR)/stratus_hls.bdl :
	@if [ ! -d $(HammingMatch_UNROLL_WORKLIB) ]; then mkdir -p $(HammingMatch_UNROLL_WORKLIB); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi

$(HammingMatch_UNROLL_SRCDIR)_%/stratus_hls.bdl :
	@if [ ! -d $(HammingMatch_UNROLL_WORKLIB)_$(*F) ]; then mkdir -p $(HammingMatch_UNROLL_WORKLIB)_$(*F); fi
	@if [ ! -f $@ ]; then echo "createEmptyBdl $@ MEMORY 0" | $(STRATUS_HOME)/bin/bdw_shell; fi



$(HammingMatch_UNROLL_WORKLIB)/HammingMatch_UNROLL.d :
	@if [ ! -d $(HammingMatch_UNROLL_WORKLIB) ]; then mkdir -p $(HammingMatch_UNROLL_WORKLIB); fi
	@touch $(HammingMatch_UNROLL_WORKLIB)/HammingMatch_UNROLL.d



#
# HLS config PIPE1
#

#
#	stratus_hls rule
#
LIB_DIRS_HammingMatch_PIPE1 = 
LIB_INCLUDES_HammingMatch_PIPE1 = $(addprefix -I,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_PIPE1))) $(addprefix -I,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS)))
LIB_NAMES_HammingMatch_PIPE1 = 
LIB_NAMES_FOR_VLOG_HammingMatch_PIPE1 = 
PREFIXED_LIB_NAMES_HammingMatch_PIPE1 = 
EXTRACT_LIB_DASHI_HammingMatch_PIPE1 = $(shell echo "puts stdout [extractHoistLibDashIs project.tcl HammingMatch PIPE1]" | $(STRATUS_HOME)/bin/bdw_shell)
CCFLAGS_HammingMatch_PIPE1 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/c_parts -DPIPE1=1 -DBDW_RTL_HammingMatch_PIPE1=1  -DPIPELINE -DII=1 -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_PIPE1)
CCFLAGS_COSIM_HammingMatch_PIPE1 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/c_parts -DPIPE1=1 -DBDW_RTL_HammingMatch_PIPE1=1  -DPIPELINE -DII=1 -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_PIPE1)
CCFLAGS_BEH_HammingMatch_PIPE1 = -I./ -I$(BDW_WRAPDIR)  -DBDW_CC_SPEC=1 -I$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/c_parts -DPIPE1=1  -DPIPELINE -DII=1 -DDPOPT_ALL -DLAT=HLS_ACHIEVABLE $(LIB_INCLUDES_HammingMatch_PIPE1)
CCFLAGS_HammingMatch_PIPE1 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_COSIM_HammingMatch_PIPE1 += ${BDW_CCFLAGS_TAIL}
CCFLAGS_BEH_HammingMatch_PIPE1 += ${BDW_CCFLAGS_TAIL}

hls_HammingMatch_PIPE1 : hlsc_HammingMatch_PIPE1

cynth_HammingMatch_PIPE1 : hlsc_HammingMatch_PIPE1

elab_HammingMatch_PIPE1 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/stratus_hls.bdr

optim_HammingMatch_PIPE1 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/stratus_hls.bdr

sched_HammingMatch_PIPE1 : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/stratus_hls.bdr

.PHONY: hlsc_HammingMatch_PIPE1 hls_HammingMatch_PIPE1

hlsc_HammingMatch_PIPE1 : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_rtl.cpp BDW_DEP_CYNTH_CONFIG=PIPE1 BDW_MODULE=HammingMatch BDW_HLS_CONFIG=PIPE1
else
	@bdw_exec -jobproject project.tcl -job hls.HammingMatch.PIPE1 $(MAKE) CWBExec_hls=1 hlsc_HammingMatch_PIPE1
endif

clean_cynth_HammingMatch_PIPE1: clean_hls_HammingMatch_PIPE1

clean_HammingMatch_PIPE1: clean_hls_HammingMatch_PIPE1

clean_hls_HammingMatch_PIPE1:
	@rm -rf $(BDW_WORKLIB)/modules/HammingMatch/PIPE1
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.PIPE1
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.PIPE1.s

kill_hls_HammingMatch_PIPE1:
	@bdw_kill -job hls.HammingMatch.PIPE1
	@bdw_kill -job hls.HammingMatch.PIPE1.s


hls_HammingMatch_PIPE1_% : hlsc_HammingMatch_PIPE1_%

cynth_HammingMatch_PIPE1_% : hlsc_HammingMatch_PIPE1_%

elab_HammingMatch_PIPE1_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=elab" $(MAKE) $(subst /PIPE1/,/PIPE1_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/stratus_hls.bdr)

optim_HammingMatch_PIPE1_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(subst /PIPE1/,/PIPE1_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/stratus_hls.bdr)

sched_HammingMatch_PIPE1_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(subst /PIPE1/,/PIPE1_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/stratus_hls.bdr)

.PHONY: hlsc_HammingMatch_PIPE1_% hls_HammingMatch_PIPE1_%

hlsc_HammingMatch_PIPE1_% hls_HammingMatch_PIPE1_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /PIPE1/,/PIPE1_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_rtl.cpp) BDW_DEP_CYNTH_CONFIG=PIPE1 BDW_MODULE=HammingMatch BDW_HLS_CONFIG=PIPE1_$(*F)
else
	@bdw_exec -jobproject project.tcl -job hls.HammingMatch.PIPE1_$(*F) $(MAKE) CWBExec_hls=1 hlsc_HammingMatch_PIPE1_$(*F)
endif

clean_cynth_HammingMatch_PIPE1_%: clean_hls_HammingMatch_PIPE1_%

clean_HammingMatch_PIPE1_%: clean_hls_HammingMatch_PIPE1_%

clean_hls_HammingMatch_PIPE1_%:
	@rm -rf $(BDW_WORKLIB)/modules/HammingMatch/PIPE1_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.PIPE1_$(*F)
	@rm -rf $(BDW_WORKLIB)/jobs/hls.HammingMatch.PIPE1_$(*F).s

kill_hls_HammingMatch_PIPE1_%:
	@bdw_kill -job hls.HammingMatch.PIPE1_$(*F)
	@bdw_kill -job hls.HammingMatch.PIPE1_$(*F).s


ifeq ($(BDW_DEP_CYNTH_CONFIG),PIPE1)
    ifeq ($(findstring CLEAN,$(MAKECMDGOALS)),)
        ifeq ($(findstring clean,$(MAKECMDGOALS)),)
            ifeq ($(findstring help,$(MAKECMDGOALS)),)
                -include $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch.d
                BDW_LIB_DEPS = 
            endif
        endif
    endif
endif


html_HammingMatch_PIPE1 :
	bdw_htmlgen -project project.tcl -module HammingMatch -cynthconfig PIPE1

BDW_HammingMatch_PIPE1_HLS_TARGETS = $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_rtl.cpp $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_rtl.v $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/stratus_hls.bdr
BDW_HammingMatch_PIPE1_HLS_SPEC_TARGETS = $(subst /PIPE1/,/PIPE1_%/,$(BDW_HammingMatch_PIPE1_HLS_TARGETS))




ifeq ($(CWBExec_hlsc),1)

$(BDW_HammingMatch_PIPE1_HLS_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/HammingMatch/PIPE1 ]; then mkdir -p $(BDW_WORKLIB)/modules/HammingMatch/PIPE1; fi
	
	$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE1 BDW_CYNTH_CONFIG=PIPE1 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_rtl.cpp \
		BDW_MODULE=HammingMatch \
		BDW_CYNTH_CONFIG=PIPE1 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/PIPE1 \
		BDW_HLS_CONFIG=PIPE1 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/PIPE1 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_HammingMatch_PIPE1) \
		-d $(BDW_WORKLIB)/modules/HammingMatch/PIPE1 -o HammingMatch_rtl.cpp \
		--hls_module=HammingMatch --hls_config=PIPE1 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_PIPE1))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_HammingMatch_PIPE1))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_HammingMatch_PIPE1))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_HammingMatch_PIPE1) \
		 ../HammingMatch.cpp
	
	
	
	

else

$(BDW_HammingMatch_PIPE1_HLS_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.HammingMatch.PIPE1.s $(MAKE) -j1 CWBExec_hlsc=1 $(BDW_HammingMatch_PIPE1_HLS_TARGETS)

endif

	
$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_trace.h : $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_trace.h.updated

$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_trace.h.updated : $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_rtl.cpp $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module HammingMatch -cynthconfig PIPE1  
	@touch $(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_trace.h.updated

ifeq ($(CWBExec_hlsc),1)

$(BDW_HammingMatch_PIPE1_HLS_SPEC_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	@if [ ! -d $(BDW_WORKLIB)/modules/HammingMatch/PIPE1_$(*F) ]; then mkdir -p $(BDW_WORKLIB)/modules/HammingMatch/PIPE1_$(*F); fi
	
	$(subst /PIPE1 ,/PIPE1_$(*F) ,$(subst =PIPE1 ,=PIPE1_$(*F) ,$(subst /HammingMatch/PIPE1/,/HammingMatch/PIPE1_$(*F)/,$(BDW_EXEC_CMD) BDW_HLS_CONFIG=PIPE1 BDW_CYNTH_CONFIG=PIPE1 \
		BDW_VRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_rtl.v \
		BDW_CRTL_FILE=$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_rtl.cpp \
		BDW_MODULE=HammingMatch \
		BDW_CYNTH_CONFIG=PIPE1 \
		BDW_CYNTH_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/PIPE1 \
		BDW_HLS_CONFIG=PIPE1 \
		BDW_HLS_CONFIG_DIR=$(BDW_WORKLIB)/modules/HammingMatch/PIPE1 \
	$(CYNTHHL) $(HL_FLAGS) $(HL_FLAGS_HammingMatch_PIPE1) \
		`cat  $(BDW_SPECLIB)/HammingMatch/PIPE1.$(*F).bds | grep '^cmdline:' | sed 's/^cmdline://'`\
		-d $(BDW_WORKLIB)/modules/HammingMatch/PIPE1 -o HammingMatch_rtl.cpp \
		--hls_module=HammingMatch --hls_config=PIPE1 --project=project.tcl \
		$(addprefix -P ,$(addsuffix /c_parts,$(LIB_DIRS_HammingMatch_PIPE1))) \
		$(addprefix -p , $(notdir $(LIB_NAMES_HammingMatch_PIPE1))) \
		$(addprefix -pu , $(notdir $(PREFIXED_LIB_NAMES_HammingMatch_PIPE1))) \
		$(addprefix -I ,$(addsuffix /c_parts,$(BDW_INDLIB_DIRS))) \
		$(EXTRACT_LIB_DASHI_HammingMatch_PIPE1) \
		 ../HammingMatch.cpp)))
	
	
	
	

else

$(BDW_HammingMatch_PIPE1_HLS_SPEC_TARGETS) :  ../HammingMatch.cpp  $(BDW_LIB_DEPS)
	bdw_exec -jobproject project.tcl -job hls.HammingMatch.PIPE1_$(*F).s $(MAKE) -j1 CWBExec_hlsc=1 $(subst %,$(*F),$(BDW_HammingMatch_PIPE1_HLS_SPEC_TARGETS))

endif

	

$(subst /PIPE1/,/PIPE1_%/,$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_trace.h) : $(subst /PIPE1/,/PIPE1_%/,$(BDW_WORKLIB)/modules/HammingMatch/PIPE1/HammingMatch_rtl.cpp) $(BDW_LOGOPTIONS_FILE)
	$(STRATUS_HOME)/bin/bdw_tracegen -module HammingMatch -cynthconfig PIPE1_$(*F)  

