optim_HammingMatch_PIPE4_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=optim" $(MAKE) $(subst /PIPE4/,/PIPE4_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/PIPE4/stratus_hls.bdr)

sched_HammingMatch_PIPE4_% : 
	@BDW_EXTRA_HLFLAGS="$(BDW_EXTRA_HLFLAGS) --run_through=sched" $(MAKE) $(subst /PIPE4/,/PIPE4_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/PIPE4/stratus_hls.bdr)

.PHONY: hlsc_HammingMatch_PIPE4_% hls_HammingMatch_PIPE4_%

hlsc_HammingMatch_PIPE4_% hls_HammingMatch_PIPE4_% : 
ifeq ($(CWBExec_hls),1)
	@$(BDW_LAUNCH_HLS_COMMAND) $(MAKE) $(subst /PIPE4/,/PIPE4_$(*F)/,$(BDW_WORKLIB)/modules/HammingMatch/PIPE4/HammingMatch_rtl.cpp) BDW_DEP_CYNTH_CONFIG=PIPE4 BDW_MODULE=HammingMatch BDW_HLS_CONFIG=PIPE4_$(*F)
else
	@bdw_exec -jobproject project.tcl -job hls.HammingMatch.PIPE4_$(*F) $(MAKE) CWBExec_hls=1 hlsc_HammingMatch_PIPE4_$(*F)
endif

